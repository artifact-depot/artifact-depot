{
	"name": "artifact-depot",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile",
		"target": "dev",
		"args": {
			"DOCKER_MIRROR": "",
			"APT_MIRROR": ""
		}
	},
	"customizations": {
		"vscode": {
			"settings": {},
			"extensions": [
				"anthropic.claude-code",
				"eamodio.gitlens",
				"rust-lang.rust-analyzer",
				"Vue.volar",
				"redhat.vscode-yaml",
				"timonwong.shellcheck",
				"exiasr.hadolint"
			]
		}
	},
	// /workspace is a named volume so sibling clones, scratch dirs, and
	// container-side worktrees persist across rebuilds; the repo bind-mounts
	// into it at /workspace/artifact-depot (see workspaceMount below).
	"mounts": [
		"source=artifact-depot-workspace,target=/workspace,type=volume",
		"source=artifact-depot-worktrees,target=/worktrees,type=volume",
		"source=artifact-depot-build,target=/build,type=volume"
	],
	"appPort": [],
	"forwardPorts": [4000, 8080],
	"portsAttributes": {
		"4000": {
			"label": "Jekyll docs (make docs-serve)",
			"onAutoForward": "openBrowser"
		},
		"8080": {
			"label": "Depot server (make demo)",
			"onAutoForward": "notify"
		}
	},
	"privileged": true,
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace/artifact-depot,type=bind",
	"workspaceFolder": "/workspace/artifact-depot"
}
